<pluginctl:PluginUserControl x:Class="SaveVault.Views.GameVaultControl"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:pluginctl="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                             xmlns:conv="clr-namespace:SaveVault.Converters"
                             xmlns:vm="clr-namespace:SaveVault.ViewModels"
                             mc:Ignorable="d"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             d:DesignHeight="320" d:DesignWidth="900">

    <pluginctl:PluginUserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="TextToVis" />
        <conv:InvertedBooleanToVisibilityConverter x:Key="NotToVis" />

        <!-- Quiet text link. Templated down to bare text on purpose: the host theme's Button style
             would paint three filled buttons into what should read as a caption row. -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Foreground="{DynamicResource SaveVaultSubTextBrush}"
                                   FontSize="{DynamicResource SaveVaultSmallFontSize}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{DynamicResource SaveVaultAccentBrush}" />
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Label" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pin toggle. A star drawn as text rather than a font glyph so the CJK fallback fonts
             this library needs cannot turn it into a box. -->
        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Star" Text="&#x2605;" Opacity="0.28"
                                       Foreground="{DynamicResource SaveVaultSubTextBrush}"
                                       FontSize="{DynamicResource SaveVaultSmallFontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Star" Property="Opacity" Value="1" />
                                <Setter TargetName="Star" Property="Foreground"
                                        Value="{DynamicResource SaveVaultPendingBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Star" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SaveVaultChipBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource SaveVaultCornerRadius}" />
            <Setter Property="Padding" Value="6,1,6,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SaveVaultSubTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource SaveVaultSmallFontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </pluginctl:PluginUserControl.Resources>

    <Border Background="{DynamicResource SaveVaultSectionBackgroundBrush}"
            Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
        <StackPanel>

            <!-- ================================================================= header -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status dot: green protected, amber found but never backed up, grey unknown. -->
                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource SaveVaultUnknownBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Protected">
                                    <Setter Property="Fill" Value="{DynamicResource SaveVaultProtectedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                    <Setter Property="Fill" Value="{DynamicResource SaveVaultPendingBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource LOCSaveVaultName}"
                               Foreground="{DynamicResource SaveVaultTextBrush}"
                               FontSize="{DynamicResource SaveVaultHeaderFontSize}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Small}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource Link}" Command="{Binding BackupCommand}"
                            Content="{DynamicResource LOCSaveVaultActionBackup}" />
                    <Button Style="{StaticResource Link}" Command="{Binding DetectCommand}"
                            Content="{DynamicResource LOCSaveVaultActionDetect}" />
                    <Button Style="{StaticResource Link}" Command="{Binding ManageCommand}"
                            Content="{DynamicResource LOCSaveVaultActionManage}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Small}" Margin="17,0,0,8"
                       Visibility="{Binding DetailText, Converter={StaticResource TextToVis}}" />

            <!-- ============================================================== snapshots -->
            <ItemsControl ItemsSource="{Binding Snapshots}" Margin="17,0,0,0"
                          Visibility="{Binding HasSnapshots, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SaveVaultCardBackgroundBrush}"
                                BorderBrush="{DynamicResource SaveVaultCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource SaveVaultCornerRadius}"
                                Padding="8,5,8,5" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="0" Style="{StaticResource PinToggle}"
                                              IsChecked="{Binding Pinned}"
                                              ToolTip="{DynamicResource LOCSaveVaultActionPin}" />

                                <TextBlock Grid.Column="1" Text="{Binding MomentText}" Margin="4,0,10,0"
                                           Foreground="{DynamicResource SaveVaultTextBrush}"
                                           FontSize="{DynamicResource SaveVaultTextFontSize}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2" Text="{Binding DetailText}"
                                           Style="{StaticResource Small}"
                                           ToolTip="{Binding SourcesText}" />

                                <Border Grid.Column="3" Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding TriggerText}" Style="{StaticResource Small}" />
                                </Border>

                                <Button Grid.Column="4" Style="{StaticResource Link}" Margin="6,0,0,0"
                                        Content="{DynamicResource LOCSaveVaultActionRestore}"
                                        Command="{Binding DataContext.RestoreCommand,
                                                  RelativeSource={RelativeSource AncestorType=pluginctl:PluginUserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource Link}" Margin="17,2,0,0" HorizontalAlignment="Left"
                    Content="{Binding MoreText}" Command="{Binding ManageCommand}"
                    Visibility="{Binding MoreText, Converter={StaticResource TextToVis}}" />

            <!-- ================================================================ targets -->
            <StackPanel Margin="17,8,0,0" Visibility="{Binding HasTargets, Converter={StaticResource BoolToVis}}">
                <Button Command="{Binding ToggleTargetsCommand}" HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <!-- Path chevron rather than a font glyph, for the same reason as the star. -->
                                <Path x:Name="Arrow" Width="8" Height="8" Stretch="Uniform"
                                      Margin="0,0,6,0" VerticalAlignment="Center"
                                      Fill="{DynamicResource SaveVaultSubTextBrush}"
                                      Data="M 0,0 L 6,4 L 0,8 Z" />
                                <TextBlock x:Name="Caption" Text="{DynamicResource LOCSaveVaultTargetsCaption}"
                                           Foreground="{DynamicResource SaveVaultSubTextBrush}"
                                           FontSize="{DynamicResource SaveVaultSmallFontSize}" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding TargetsExpanded}" Value="True">
                                    <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 8,0 L 4,6 Z" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Caption" Property="Foreground"
                                            Value="{DynamicResource SaveVaultAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ItemsControl ItemsSource="{Binding Targets}" Margin="14,6,0,0"
                              Visibility="{Binding TargetsExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          ToolTip="{DynamicResource LOCSaveVaultTargetEnabledHint}" />

                                <Border Grid.Column="1" Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding OriginText}" Style="{StaticResource Small}" />
                                </Border>

                                <Button Grid.Column="2" Style="{StaticResource Link}" Margin="0,0,0,0"
                                        HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                        Content="{Binding PathText}" ToolTip="{Binding PathText}"
                                        Command="{Binding DataContext.OpenPathCommand,
                                                  RelativeSource={RelativeSource AncestorType=pluginctl:PluginUserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ================================================================= empty -->
            <TextBlock Margin="17,4,0,0" Style="{StaticResource Small}" TextWrapping="Wrap"
                       Text="{DynamicResource LOCSaveVaultEmptyHint}"
                       Visibility="{Binding HasTargets, Converter={StaticResource NotToVis}}" />
        </StackPanel>
    </Border>
</pluginctl:PluginUserControl>
