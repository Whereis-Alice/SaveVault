    <sys:String x:Key="LOCSaveVaultNoTargets">No save location is known for this game yet. Run detection, play it once with learning enabled, or add a path by hand.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptAutoScan">Detect automatically for new games</sys:String>
    <sys:String x:Key="LOCSaveVaultOptAutoScanHint">Runs detection the first time a game is added to the library or launched.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptBackupBeforeLaunch">Back up before launching</sys:String>
    <sys:String x:Key="LOCSaveVaultOptBackupBeforeLaunchHint">Launching takes a moment longer, but every session gets a rollback point.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptBackupOnStop">Back up after playing</sys:String>
    <sys:String x:Key="LOCSaveVaultOptBackupOnStopHint">Runs when a game closes. Nothing is written when the saves have not changed.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptBackupRoot">Backup folder</sys:String>
    <sys:String x:Key="LOCSaveVaultOptBackupRootHint">Every snapshot lives here. Prefer a drive other than the system drive.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptCandidateHint">Folders larger than these limits are treated as game data instead of saves and are skipped during detection.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptCompress">Compress snapshots</sys:String>
    <sys:String x:Key="LOCSaveVaultOptCompressHint">Smaller snapshots, slightly slower backups. Turn this off for very large saves.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptConfirmRestore">Ask before restoring</sys:String>
    <sys:String x:Key="LOCSaveVaultOptKeepDaily">Keep one per day for</sys:String>
    <sys:String x:Key="LOCSaveVaultOptKeepWeekly">Keep one per week for</sys:String>
    <sys:String x:Key="LOCSaveVaultOptLearning">Learn save locations while playing</sys:String>
    <sys:String x:Key="LOCSaveVaultOptLearningHint">Watches the install folder and the usual save folders while a game runs, and remembers whatever it actually writes to. This is the most reliable option for niche and doujin titles.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptManifestPathHint">Leave empty to use Ludusavi's default manifest location. The file is only read; Ludusavi is never launched.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptMaxCandidateFiles">Largest folder to accept, in files</sys:String>
    <sys:String x:Key="LOCSaveVaultOptMaxCandidateSize">Largest folder to accept</sys:String>
    <sys:String x:Key="LOCSaveVaultOptMaxSnapshotFiles">Largest snapshot to write, in files</sys:String>
    <sys:String x:Key="LOCSaveVaultOptMaxSnapshotSize">Largest snapshot to write</sys:String>
    <sys:String x:Key="LOCSaveVaultOptMaxSnapshots">Snapshots per game</sys:String>
    <sys:String x:Key="LOCSaveVaultOptMaxTotal">Total size limit</sys:String>
    <sys:String x:Key="LOCSaveVaultOptNotify">Show a notification after each backup</sys:String>
    <sys:String x:Key="LOCSaveVaultOptRegistry">Include registry keys</sys:String>
    <sys:String x:Key="LOCSaveVaultOptRegistryHint">A few games keep their saves in the registry. Export and import go through reg.exe, which is riskier, so this is off by default.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptRetentionHint">The newest and all pinned snapshots are always kept, then one per day and one per week. When the total size limit is exceeded the oldest snapshots go first, and every game keeps at least one.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptScanInstall">Search the install folder</sys:String>
    <sys:String x:Key="LOCSaveVaultOptScanInstallHint">Looks for the usual subfolders such as save, savedata and セーブ. Best for portable and doujin releases.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptScanUser">Search user folders</sys:String>
    <sys:String x:Key="LOCSaveVaultOptScanUserHint">Looks for folders matching the game name under Documents, AppData, Saved Games and similar locations.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptScheduleInterval">Interval</sys:String>
    <sys:String x:Key="LOCSaveVaultOptScheduled">Back up on a schedule</sys:String>
    <sys:String x:Key="LOCSaveVaultOptScheduledHint">Checks once per interval while Playnite is running. Only games whose saves changed get a new snapshot.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptSnapshotHint">A game whose save location is bigger than this is skipped and reported instead of eating the whole vault budget. 0 removes the limit.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptTopPanel">Show a button in the top panel</sys:String>
    <sys:String x:Key="LOCSaveVaultOptTopPanelHint">Opens the vault in one click, and shows how much of the size budget is used.</sys:String>
    <sys:String x:Key="LOCSaveVaultOptUseLudusavi">Use the Ludusavi manifest</sys:String>
    <sys:String x:Key="LOCSaveVaultOptUseLudusaviHint">Reads Ludusavi's save-path database as one more hint. Ludusavi itself is not required, and Japanese niche titles are usually missing from it.</sys:String>
